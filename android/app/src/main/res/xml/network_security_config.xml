<?xml version="1.0" encoding="utf-8"?>
<!-- Websites can still be http (the user can turn on HTTPS-only in Settings). Tide's own
     network calls (the dangerous-site list) are https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
